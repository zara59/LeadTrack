# LeadTrack API — environment
# Copy to .env and adjust for your machine. No real secrets here.
#
# Required by Stage 4: the API reads ALL data from PostgreSQL.

# Port the Express server listens on.
# NOTE: 4000 was already taken by another local service on this machine, so
# the LeadTrack API defaults to 4001. Change freely per environment.
PORT=4001

# PostgreSQL connection string (placeholder — replace with your own).
# A local Postgres.app install with trust auth needs no password:
#   DATABASE_URL=postgresql://localhost:5432/leadtrack
DATABASE_URL=postgresql://username:password@localhost:5432/leadtrack

# Comma-separated allowlist of browser origins allowed to call the API
# (the Vite dev servers for the LeadTrack frontend). Do not use "*".
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174# Required by Stage 5: JWT signing secret (REQUIRED, never commit a real one).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-hex-secret

# Optional: token lifetime, e.g. 7d
# JWT_EXPIRES_IN=7d
